---
import { Icon } from '@astrojs/starlight/components';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="landing-section landing-cta" aria-labelledby="landing-cite">
  <div class="landing-cta__cite">
    <h2 id="landing-cite" class="landing-h2">Peer reviewed and published</h2>
    <figure class="landing-citation">
      <p>
        Md Hasanul Banna Siam, Md Akkas Ali, Donald Vardaman, Satwik Acharyya, Mallikarjun Patil,
        Daniel J Tyrrell, <cite>CAFE: an integrated web app for high-dimensional analysis and
        visualization in spectral flow cytometry</cite>, Bioinformatics, Volume 41, Issue 6, June 2025,
        btaf176.
      </p>
      <figcaption>
        <a href="https://doi.org/10.1093/bioinformatics/btaf176">doi.org/10.1093/bioinformatics/btaf176</a>
      </figcaption>
    </figure>
    <a class="landing-link" href={`${base}/others/citation/`}>
      How to cite CAFE <Icon name="right-arrow" />
    </a>
  </div>
  <div class="landing-cta__install">
    <h2 class="landing-h2">Install CAFE in minutes</h2>
    <p>Runs on Windows, macOS and Linux. Install with uv, pixi or conda, then open CAFE in your browser.</p>
    <div class="landing-actions">
      <a class="landing-btn landing-btn--primary" href={`${base}/installation/system_requirements/`}>
        Installation guide <Icon name="right-arrow" />
      </a>
      <a class="landing-btn landing-btn--ghost" href={`${base}/getting-started/introduction/`}>
        Read the docs
      </a>
    </div>
  </div>
</section>
