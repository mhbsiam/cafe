---
import { Icon } from '@astrojs/starlight/components';
import CellCloud from './CellCloud.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="landing-hero" aria-labelledby="landing-title">
  <div class="landing-hero__copy">
    <p class="landing-badge">
      <span class="landing-badge__dot" aria-hidden="true"></span>
      Published in <em>Bioinformatics</em>
      <span class="landing-badge__meta">2025</span>
    </p>
    <h2 id="landing-title" class="landing-hero__title">
      Spectral flow cytometry analysis, <span>no code required.</span>
    </h2>
    <p class="landing-hero__lede">
      CAFE takes you from scaled CSV exports to publication-ready figures. Quality control, batch
      correction, UMAP and Leiden clustering, and interactive exploration, all in one free app that
      runs on your own computer.
    </p>
    <div class="landing-actions">
      <a class="landing-btn landing-btn--primary" href={`${base}/getting-started/introduction/`}>
        Get started <Icon name="right-arrow" />
      </a>
      <a class="landing-btn landing-btn--secondary" href="https://doi.org/10.1093/bioinformatics/btaf176">
        Read the paper <Icon name="external" />
      </a>
      <a class="landing-btn landing-btn--ghost" href="https://github.com/mhbsiam/cafe">
        <Icon name="github" /> GitHub
      </a>
    </div>
  </div>
  <CellCloud />
</section>
